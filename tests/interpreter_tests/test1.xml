<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26">
  <class name="Calculator" parent="Object">
    <method selector="apply:a:b:">
      <block arity="3">
        <parameter order="1" name="op"/>
        <parameter order="2" name="a"/>
        <parameter order="3" name="b"/>
        <assign order="1">
          <var name="r"/>
          <expr>
            <send selector="value:value:">
              <expr>
                <var name="op"/>
              </expr>
              <arg order="1">
                <expr>
                  <var name="a"/>
                </expr>
              </arg>
              <arg order="2">
                <expr>
                  <var name="b"/>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="calc"/>
          <expr>
            <send selector="new">
              <expr>
                <literal class="class" value="Calculator"/>
              </expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="addBlock"/>
          <expr>
            <block arity="2">
              <parameter order="1" name="x"/>
              <parameter order="2" name="y"/>
              <assign order="1">
                <var name="r"/>
                <expr>
                  <send selector="plus:">
                    <expr>
                      <var name="x"/>
                    </expr>
                    <arg order="1">
                      <expr>
                        <var name="y"/>
                      </expr>
                    </arg>
                  </send>
                </expr>
              </assign>
            </block>
          </expr>
        </assign>
        <assign order="3">
          <var name="mulBlock"/>
          <expr>
            <block arity="2">
              <parameter order="1" name="x"/>
              <parameter order="2" name="y"/>
              <assign order="1">
                <var name="r"/>
                <expr>
                  <send selector="multiplyBy:">
                    <expr>
                      <var name="x"/>
                    </expr>
                    <arg order="1">
                      <expr>
                        <var name="y"/>
                      </expr>
                    </arg>
                  </send>
                </expr>
              </assign>
            </block>
          </expr>
        </assign>
        <assign order="4">
          <var name="re1"/>
          <expr>
            <send selector="value:value:">
              <expr>
                <var name="addBlock"/>
              </expr>
              <arg order="1">
                <expr>
                  <literal class="Integer" value="5"/>
                </expr>
              </arg>
              <arg order="2">
                <expr>
                  <literal class="Integer" value="6"/>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
